# SETTINGS AND CONFIG ACCESS
#
# The *config aliases point into $DOTFILES rather than at the stow symlinks in
# ~/.config. Editing through a symlink does reach the repo, but only while the
# package is actually stowed — and when it silently isn't (stow skips a target
# that already exists as a real file), edits land in an untracked copy and the
# repo quietly goes stale. Going straight to the source makes that impossible,
# and fails loudly if a path is wrong instead of failing silently.
#
# Single quotes so $DOTFILES is expanded when the alias runs, not when it is
# defined. $DOTFILES is exported from ~/.zshenv.
alias vim="nvim"
alias zshconfig='nvim $DOTFILES/zsh/.zshrc'
alias aliasconfig='cd $DOTFILES/shell/.config && nvim .aliases && cd -'
alias functionsconfig='cd $DOTFILES/shell/.config && nvim .functions && cd -'
alias zsource="source ~/.zshrc"
alias vimconfig="nvim ~/.vimrc"
alias nviminit='nvim $DOTFILES/nvim/.config/nvim/init.lua'
alias nvimconfig='cd $DOTFILES/nvim/.config/nvim && nvim . && cd -'
alias starshipconfig='cd $DOTFILES/starship/.config && nvim starship.toml && cd -'
alias ghosttyconfig="vim ~/Library/Application\ Support/com.mitchellh.ghostty/config"
alias skhdconfig='cd $DOTFILES/skhd/.config/skhd && nvim skhdrc && cd -'
alias yabaiconfig='cd $DOTFILES/yabai/.config/yabai && nvim yabairc && cd -'
alias sketchybarconfig='cd $DOTFILES/sketchybar/.config/sketchybar && nvim . && cd -'
alias dotfiles='cd $DOTFILES && nvim . && cd -'
alias geminiconfig="vim ~/.gemini/"
alias claudeconfig="vim ~/.claude/"
alias getsshpub="tr -d '\n' < ~/.ssh/id_rsa.pub | pbcopy"
# GIT SHORTCUTS
alias gs='git status'
alias gco='git checkout '
alias gcm='git commit -m '
alias gaa='git add -A'
alias gpush='git push'
alias gpull='git pull'
# BASH OVERRIDES
alias mv='mv -i'
# NAV SHORTCUTS
 alias ..='cd ..'
 alias ...='cd ../..'
 alias ....='cd ../../..'
 alias .....='cd ../../../..'
 alias ~='cd ~'
 alias dev='cd ~/Develop/' 
 alias work='cd ~/Work/'
 alias create='cd ~/Create/'
 alias divesite='work && cd divesite'
 alias dive='divesite && nvm use && zellij --layout ~/.config/zellij/layouts/divesite.kdl'
 alias divestripe='stripe listen --forward-to http://localhost:8000/api/v3/pressrelease/stripe-purchase-package-webhook'
 alias icloud='cd ~/Library/Mobile\ Documents/'
 alias portfolio='cd ~/Develop/portfolio-2025/ && vim . && cd -'
 alias blog='cd ~/Develop/portfolio-2025/ && vim .drafts && cd -'
 alias prep='cd ~/Develop/prep && vim . && cd -'
# DOCK SPACERS
 alias dockspace="defaults write com.apple.dock persistent-apps -array-add '{"tile-type"="spacer-tile";}'; killall Dock"
 alias dockspacesmall="defaults write com.apple.dock persistent-apps -array-add '{"tile-type"="small-spacer-tile";}'; killall Dock"
# DIVE STUFF
 alias divesleep="echo 'DIVESITE_LOCAL_APP_COMMAND=sleep inf' >> .env"
# OBSIDIAN
 alias obs-me="cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/me && nvim scratch.md && cd -"
 alias obs-work="cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/work && nvim todo.md -c 'Obsidian today' && cd -"
# Docker SHORTCUTS
alias dexdive="docker exec divesite-app-1"
alias dex="docker exec"
alias dsapp="divesite-app-1"
