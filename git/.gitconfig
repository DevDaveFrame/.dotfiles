# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
	name = Dave Frame
    email = dframe22@gmail.com
[column]
        ui = auto
[branch]
        sort = -committerdate
[fetch]
        prune = true
        pruneTags = true
        all = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[push]
    autoSetupRemote = true
[difftool "vimdiff"]
	cmd = vimdiff \"$LOCAL\" \"$REMOTE\"
[diff]
	tool = vimdiff
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[core]
	excludesfile = ~/.gitignore
