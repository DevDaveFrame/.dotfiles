#!/usr/bin/env bash
set -euo pipefail

fmt()  { printf "\n\033[1;34m==> %s\033[0m\n" "$*"; }
ok()   { printf "  \033[32m✓\033[0m %s\n" "$*"; }
skip() { printf "  \033[33m⏭\033[0m %s (already installed)\n" "$*"; }

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STOW_PACKAGES=(git nvim starship zsh zellij skhd yabai sketchybar shell ghostty claude kanata)

# stow silently does nothing when a target already exists as a real file or
# directory, which is how nvim/zsh/zellij/skhd/shell drifted out of the repo for
# months. Fail loudly instead.
#
# A correctly stowed target resolves back to the repo file. Test that, not
# `-L` on the leaf: stow folds a whole directory into one symlink where it can
# (~/.config/yabai is a single symlink, not one per file), so `-L` on the files
# inside is false for every one of them and reported all of yabai, sketchybar
# and kanata as drift.
check_stow_conflicts() {
  local pkg conflicts=0
  for pkg in "${STOW_PACKAGES[@]}"; do
    [[ -d "$DOTFILES/$pkg" ]] || continue
    while IFS= read -r src; do
      local rel="${src#$DOTFILES/$pkg}" tgt
      tgt="$HOME$rel"
      [[ -e "$tgt" ]] || continue
      if [[ "$(readlink -f "$tgt")" != "$src" ]]; then
        printf "  \033[31m!\033[0m %s is a real file, not a stow symlink\n" "$tgt"
        conflicts=1
      fi
      # Skip what stow will never link: its built-in default ignore list
      # (which includes .gitignore -- see the turnstile-spin skill templates),
      # the per-package ignore file, and kanata/launchd, which goes to
      # /Library/LaunchDaemons instead of $HOME.
    done < <(find "$DOTFILES/$pkg" \
      -name .stow-local-ignore -prune -o \
      -name .gitignore -prune -o \
      -path "$DOTFILES/kanata/launchd" -prune -o \
      -type f ! -name .gitkeep -print)
  done
  return $conflicts
}

# ─────────────────────────────────────────────
# 1. Xcode CLI tools + Homebrew
# ─────────────────────────────────────────────
fmt "Xcode CLI tools"
if xcode-select -p &>/dev/null; then
  skip "Xcode CLI tools"
else
  xcode-select --install
  echo "  Waiting for Xcode CLI tools install to finish..."
  until xcode-select -p &>/dev/null; do sleep 5; done
  ok "Xcode CLI tools"
fi

fmt "Homebrew"
if command -v brew &>/dev/null; then
  skip "Homebrew"
else
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
  ok "Homebrew"
fi

# ─────────────────────────────────────────────
# 2. Languages
# ─────────────────────────────────────────────
fmt "Rust (rustup)"
if command -v rustup &>/dev/null; then
  skip "Rust"
else
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
  ok "Rust"
fi

fmt "Go"
if brew list go &>/dev/null; then
  skip "Go"
else
  brew install go
  ok "Go"
fi

fmt "Python (pyenv)"
if command -v pyenv &>/dev/null; then
  skip "pyenv"
else
  brew install pyenv
  eval "$(pyenv init -)"
  ok "pyenv"
fi
# Capture first, then match. `cmd | grep -q` is a trap under `set -o pipefail`:
# grep exits at the first match and closes the pipe, the producer dies of
# SIGPIPE, and pipefail reports that as the pipeline's status -- so `!` inverted
# this guard and it reinstalled Python on every run.
py_versions="$(pyenv versions --bare 2>/dev/null || true)"
if grep -q '^3\.' <<<"$py_versions"; then
  skip "Python 3.x"
else
  latest=$(pyenv install --list | grep -E '^\s+3\.[0-9]+\.[0-9]+$' | tail -1 | tr -d ' ')
  # -s: never prompt, and exit 0 if the version is already there. Without it a
  # "no" at the prompt returns nonzero and `set -e` kills the whole script.
  pyenv install -s "$latest"
  pyenv global "$latest"
  ok "Python $latest"
fi

fmt "Node (nvm)"
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  skip "nvm"
else
  brew install nvm
  mkdir -p "$NVM_DIR"
  # shellcheck disable=SC1091
  [[ -s "$NVM_DIR/nvm.sh" ]] || [[ -s "$(brew --prefix nvm)/nvm.sh" ]] && . "$(brew --prefix nvm)/nvm.sh"
  ok "nvm"
fi
# shellcheck disable=SC1091
[[ -s "$NVM_DIR/nvm.sh" ]] && . "$NVM_DIR/nvm.sh"
# Same pipefail/SIGPIPE trap as the pyenv guard above.
nvm_lts="$(nvm ls --no-colors 'lts/*' 2>/dev/null || true)"
if grep -q 'v' <<<"$nvm_lts"; then
  skip "Node LTS"
else
  nvm install --lts
  ok "Node LTS"
fi
if ! command -v pnpm &>/dev/null; then
  npm install -g pnpm
  ok "pnpm"
else
  skip "pnpm"
fi

# ─────────────────────────────────────────────
# 3. Tools (brew)
# ─────────────────────────────────────────────
fmt "Brew tools"
tools=(orbstack neovim starship stow fzf ripgrep lazygit gh zellij skhd yabai zsh-syntax-highlighting jq media-control kanata)
for tool in "${tools[@]}"; do
  if brew list "$tool" &>/dev/null; then
    skip "$tool"
  else
    brew install "$tool"
    ok "$tool"
  fi
done

# sketchybar and borders live in FelixKratz's tap, not homebrew-core.
# borders (JankyBorders) is launched from the end of yabairc.
fmt "FelixKratz tools"
brew tap felixkratz/formulae
for tool in sketchybar borders; do
  if brew list "$tool" &>/dev/null; then
    skip "$tool"
  else
    brew install "$tool"
    ok "$tool"
  fi
done

# ─────────────────────────────────────────────
# 4. Stow packages
# ─────────────────────────────────────────────
fmt "Stow dotfiles"
if ! check_stow_conflicts; then
  echo
  echo "  Some targets are real files rather than symlinks, so stow would skip"
  echo "  them and any edits there would never reach the repo."
  echo "  Reconcile them into \$DOTFILES first, then re-run, or adopt them with:"
  echo "    stow --dir=\"$DOTFILES\" --target=\"\$HOME\" --adopt --restow <pkg>"
  echo "  (--adopt overwrites the repo copy with the live file, so check"
  echo "   'git diff' immediately afterwards.)"
  exit 1
fi

for pkg in "${STOW_PACKAGES[@]}"; do
  if [[ -d "$DOTFILES/$pkg" ]]; then
    stow --dir="$DOTFILES" --target="$HOME" --restow "$pkg"
    ok "$pkg"
  fi
done

# ─────────────────────────────────────────────
# 5. kanata (needs sudo)
# ─────────────────────────────────────────────
#
# Three moving parts, and all of them have to line up or the keyboard silently
# stays unremapped:
#
#   1. Karabiner-DriverKit-VirtualHIDDevice, PINNED. kanata talks to it over a
#      versioned IPC protocol -- driver v6.x is protocol 5, v7.x is 6, v8.x is
#      7 -- and homebrew kanata 1.12.0 speaks protocol 5. Installing "the
#      latest" driver gives a daemon kanata cannot talk to. Bump this only
#      together with the driver version named in the kanata release notes.
#   2. The virtual HID daemon, which the standalone driver package does not
#      start by itself. Without it kanata loops `connect_failed asio.system:2`.
#   3. kanata itself, as a root LaunchDaemon.
#
# Karabiner-Elements would cover 1 and 2 for you, and must still not be
# installed: it auto-updates its bundled driver past v6 and breaks kanata.
#
# Input Monitoring and Accessibility cannot be granted from a script. See the
# kanata section of README.md.

fmt "kanata"
KANATA_DRIVER_VERSION=6.2.0
VHID_MANAGER="/Applications/.Karabiner-VirtualHIDDevice-Manager.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Manager"

if [[ -x "$VHID_MANAGER" ]]; then
  skip "Karabiner DriverKit driver"
else
  echo "  Installing Karabiner-DriverKit-VirtualHIDDevice $KANATA_DRIVER_VERSION (needs sudo)"
  pkgdir="$(mktemp -d)"
  curl -fsSL -o "$pkgdir/driver.pkg" \
    "https://github.com/pqrs-org/Karabiner-DriverKit-VirtualHIDDevice/releases/download/v${KANATA_DRIVER_VERSION}/Karabiner-DriverKit-VirtualHIDDevice-${KANATA_DRIVER_VERSION}.pkg"
  sudo installer -pkg "$pkgdir/driver.pkg" -target /
  rm -rf "$pkgdir"
  ok "Karabiner DriverKit driver $KANATA_DRIVER_VERSION"
fi

sudo "$VHID_MANAGER" forceActivate >/dev/null
ok "driver activated"

# Order matters: the virtual HID daemon has to be up before kanata starts.
# dev.kanata.logcap caps /var/log/kanata.log -- see README, kanata 1.12.0 spams
# it at ~2.5 MB/day and neither --quiet nor newsyslog can stop that.
for label in org.pqrs.Karabiner-VirtualHIDDevice-Daemon dev.kanata.kanata dev.kanata.logcap; do
  sudo install -o root -g wheel -m 644 \
    "$DOTFILES/kanata/launchd/$label.plist" "/Library/LaunchDaemons/$label.plist"
  if sudo launchctl print "system/$label" &>/dev/null; then
    sudo launchctl kickstart -k "system/$label"
    ok "$label (reloaded)"
  else
    sudo launchctl bootstrap system "/Library/LaunchDaemons/$label.plist"
    ok "$label"
  fi
done

echo "  If the keyboard is not remapped, check 'sudo tail /var/log/kanata.log'."
echo "  The usual cause is Input Monitoring -- see README.md."

# ─────────────────────────────────────────────
# 6. macOS defaults
# ─────────────────────────────────────────────
fmt "macOS defaults"

# Screenshots as JPG
defaults write com.apple.screencapture type jpg
ok "Screenshots → JPG"

# Finder: show path bar, status bar, hidden files, Library
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder AppleShowAllFiles YES
chflags nohidden ~/Library
ok "Finder prefs"

# Don't reopen previous Preview files
defaults write com.apple.Preview ApplePersistenceIgnoreState YES
ok "Preview prefs"

killall Finder &>/dev/null || true

fmt "Done! Open a new shell to pick up changes."
