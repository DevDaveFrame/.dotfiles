# ============================================================================
#  GRAMMAR
# ============================================================================
#
#  caps (hold)          SUPER = ctrl + alt + cmd      -- kanata, internal kbd
#  caps (hold) + shift  hyper = SUPER + shift         -- also the ZSA hyper key
#
#  SUPER acts on what is focused.   SUPER - h  focuses west.
#  hyper carries it.                hyper - h  swaps the window west.
#  Modes hold the long tail.        SUPER - space, SUPER - g, hyper - space/r.
#
#  ctrl, alt and cmd alone are never bound here. They belong to the focused
#  app: cmd - * to every macOS app, ctrl - <letter> and alt - hjkl to zellij.
#
#  Desktop switching stays macOS-native (ctrl - N). Moving a window across
#  desktops needs the yabai scripting addition, which needs SIP off, so it
#  lives in Hammerspoon on hyper - N instead. See ~/.hammerspoon/init.lua.
#
#  skhd has no key literal for punctuation; those bindings use raw macOS
#  keycodes (0x2B = comma, 0x2F = period).
#
# ============================================================================

# ============================================================================
#  0. Mode declarations -- must precede any binding that enters a mode
# ============================================================================
#
#  Every mode is declared '@': keys with no binding are swallowed rather than
#  leaked to the focused app. escape always returns to default.
#
#  The border colour is the mode indicator -- amber while a mode is held,
#  back to green on exit. The green must track active_color in yabairc.
#
#  skhd 0.3.9 cannot run a command *and* switch mode in one binding, so the
#  one-shot modes fake it by sending themselves an escape.

:: default            : borders active_color=0xff9ece6a
:: links       @      : borders active_color=0xffe0af68
:: layout      @      : borders active_color=0xffe0af68
:: resize      @      : borders active_color=0xffe0af68

links  < escape ; default
layout < escape ; default
resize < escape ; default

# ============================================================================
#  1. SUPER -- navigate and act on the focused window
# ============================================================================

# Launch or raise. The rest live in apps mode.
hyper - return : open -a "Ghostty"
hyper - g : open -a "Google Chrome"
hyper - s : open -a "Slack"
hyper - c : open -a "Cursor"
hyper - z : open -a "Zed"

# Type test. The one-shot rule catches the next Chrome window to spawn, so it
# lands already floating and centred -- no tile-then-float flicker -- and the
# rule removes itself once applied. Same grid as hyper - v.
hyper - t : yabai -m rule --add --one-shot app="^Google Chrome$" manage=off grid=10:10:2:2:6:6; open -na "Google Chrome" --args --new-window "https://monkeytype.com"

# Focus (vim directions)
cmd + ctrl + alt - h : yabai -m window --focus west
cmd + ctrl + alt - j : yabai -m window --focus south
cmd + ctrl + alt - k : yabai -m window --focus north
cmd + ctrl + alt - l : yabai -m window --focus east

# Cycle the windows of a stack (|| wraps around at the ends)
cmd + ctrl + alt - tab : yabai -m window --focus stack.next 2> /dev/null || yabai -m window --focus stack.first

# Window verbs
cmd + ctrl + alt - f : yabai -m window --toggle zoom-fullscreen
cmd + ctrl + alt - z : yabai -m window --toggle zoom-parent
cmd + ctrl + alt - v : yabai -m window --toggle float
cmd + ctrl + alt - i : yabai -m window --toggle split

# Space verbs
cmd + ctrl + alt - x : yabai -m space --mirror x-axis
cmd + ctrl + alt - y : yabai -m space --mirror y-axis
cmd + ctrl + alt - r : yabai -m space --rotate 90
cmd + ctrl + alt - e : yabai -m space --balance

# Stacks. 's' arms the focused window: the next window opened here stacks
# instead of splitting. Press again to disarm. 'u' pops the focused window
# back out into the bsp tree -- float and unfloat is the only way to do it.
cmd + ctrl + alt - s : yabai -m window --insert stack
cmd + ctrl + alt - u : yabai -m window --toggle float 

# ============================================================================
#  2. hyper -- carry the focused window, and the odd variants
# ============================================================================

# Swap with the window in that direction
hyper - h : yabai -m window --swap west
hyper - j : yabai -m window --swap south
hyper - k : yabai -m window --swap north
hyper - l : yabai -m window --swap east

hyper - v : ~/.config/skhd/grid.sh 10:10:2:2:6:6

# Modes
hyper - w     ; layout
hyper - a     ; links
hyper - r     ; resize

# hyper - 1..0  move window to desktop N   -> Hammerspoon
# hyper - return  Ghostty quick terminal   -> Ghostty's own global keybind


# ============================================================================
#  3. Modes -- key bindings. Declarations are in section 0, above.
# ============================================================================

# --- links: hyper - space, exits after launch -------------------------------
links < m : open -na "Google Chrome" --args --profile-directory="Profile 2" "https://gitlab.com/informatechtarget/brand/dive/divesite/-/merge_requests/?sort=created_date&state=opened&author_username=dframe1&first_page_size=20"; skhd -k "escape"
links < p : open -na "Google Chrome" --args --profile-directory="Profile 2" "https://gitlab.com/informatechtarget/brand/dive/divesite/-/pipelines"; skhd -k "escape"
links < i : open -na "Google Chrome" --args --profile-directory="Profile 2" "https://outlook.office.com/mail/"; skhd -k "escape"


# --- layout: HYPER - w, sticky ----------------------------------------------
# Warp re-parents the window into the neighbouring node; swap only trades
# places. Warp is the one that changes the shape of the tree.
layout < h : yabai -m window --warp west
layout < j : yabai -m window --warp south
layout < k : yabai -m window --warp north
layout < l : yabai -m window --warp east

# Stack the neighbouring window onto the focused window's pane
layout < shift - h : yabai -m window --stack west
layout < shift - j : yabai -m window --stack south
layout < shift - k : yabai -m window --stack north
layout < shift - l : yabai -m window --stack east

# Float-and-place presets. Each one floats the window first; see grid.sh.
layout < return : ~/.config/skhd/grid.sh 1:1:0:0:1:1
layout < 1      : ~/.config/skhd/grid.sh 1:2:0:0:1:1
layout < 2      : ~/.config/skhd/grid.sh 1:2:1:0:1:1
layout < 3      : ~/.config/skhd/grid.sh 1:4:1:0:2:1
layout < 4      : ~/.config/skhd/grid.sh 1:3:0:0:1:1
layout < 5      : ~/.config/skhd/grid.sh 1:3:2:0:1:1
layout < 6      : ~/.config/skhd/grid.sh 1:3:0:0:2:1
layout < 7      : ~/.config/skhd/grid.sh 1:3:1:0:2:1
layout < c      : ~/.config/skhd/grid.sh 5:5:1:0:2:3

# --- resize: hyper - r, sticky ----------------------------------------------
# A window owns only two of its four edges. Push the edge it owns; if that
# fails, pull the opposite one.
resize < h : yabai -m window --resize right:-40:0 2> /dev/null || yabai -m window --resize left:-40:0
resize < j : yabai -m window --resize bottom:0:40 2> /dev/null || yabai -m window --resize top:0:40
resize < k : yabai -m window --resize bottom:0:-40 2> /dev/null || yabai -m window --resize top:0:-40
resize < l : yabai -m window --resize right:40:0 2> /dev/null || yabai -m window --resize left:40:0

resize < shift - h : yabai -m window --resize left:40:0 2> /dev/null || yabai -m window --resize right:40:0
resize < shift - j : yabai -m window --resize top:0:-40 2> /dev/null || yabai -m window --resize bottom:0:-40
resize < shift - k : yabai -m window --resize top:0:40 2> /dev/null || yabai -m window --resize bottom:0:40
resize < shift - l : yabai -m window --resize left:-40:0 2> /dev/null || yabai -m window --resize right:-40:0

